# ====================================================================
# Stagework — Environment Variables
# Copy this to .env.local and fill in real values
# ====================================================================

# ---- Supabase (get from supabase.com → your project → Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ---- Google OAuth (from Google Cloud Console → APIs & Services → Credentials) ----
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ---- Restrict sign-in to your workspace domain ----
ALLOWED_GOOGLE_DOMAIN=yourcompany.com

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production: https://stagework.yourcompany.com

# ---- Encryption key for storing Google refresh tokens ----
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# ---- Cron secret (Vercel sets this; locally make one up) ----
CRON_SECRET=any-random-string
